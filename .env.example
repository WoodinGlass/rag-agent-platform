# =============================================================================
# rag-agent-platform — environment config
# Copy to .env and edit. Never commit .env.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM (agent decider)
# -----------------------------------------------------------------------------
# Provider: fake | openai | anthropic
# Default "fake" runs fully offline and always refuses with a clear message.
LLM_PROVIDER=fake
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# Embedder
# -----------------------------------------------------------------------------
# Provider: fake | openai
# "fake" is a deterministic bag-of-tokens hashing embedder (no network).
EMBEDDER_PROVIDER=fake
EMBEDDER_DIM=128


# -----------------------------------------------------------------------------
# Agent backend (M6.1)
# -----------------------------------------------------------------------------
# state_machine: deterministic loop in app/agents/agent.py (default)
# langgraph:     StateGraph-backed loop (requires [langgraph] extra)
AGENT_BACKEND=state_machine

# -----------------------------------------------------------------------------
# Vector store
# -----------------------------------------------------------------------------
# Backend: memory | chroma | qdrant
# - memory: ephemeral, in-process (tests + demo)
# - chroma: local persistent files (dev)
# - qdrant: remote/container service (compose)
VECTOR_BACKEND=memory
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=rag_docs
QDRANT_URL=http://localhost:6333

# -----------------------------------------------------------------------------
# Chunking & retrieval
# -----------------------------------------------------------------------------
CHUNK_SIZE=200
CHUNKER_VERSION=v1
TOP_K=5

# -----------------------------------------------------------------------------
# Storage (unstructured payloads)
# -----------------------------------------------------------------------------
# Backend: filesystem | s3
STORAGE_BACKEND=filesystem
DATA_DIR=./data
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# -----------------------------------------------------------------------------
# HTTP server
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000


# -----------------------------------------------------------------------------
# Multi-tenant / auth (M5.3)
# -----------------------------------------------------------------------------
# When false (default), every request is treated as the default tenant.
# When true, requests must carry X-API-Key matching an entry in TENANT_KEYS.
TENANT_AUTH_ENABLED=false
# Format: "key1:tenantA,key2:tenantB"
TENANT_KEYS=
DEFAULT_TENANT=public


# -----------------------------------------------------------------------------
# Tracing (M5.4)
# -----------------------------------------------------------------------------
# Off by default (no deps, no runtime cost).
# Enable with: pip install 'rag-agent-platform[otel]'
OTEL_ENABLED=false
OTEL_SERVICE_NAME=rag-agent-platform
# Print spans to stdout (dev). Use an OTLP exporter in production (roadmap).
OTEL_CONSOLE_EXPORTER=true

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true

# -----------------------------------------------------------------------------
# Evaluation
# -----------------------------------------------------------------------------
RAGAS_DATASET=evals/data/demo.jsonl
