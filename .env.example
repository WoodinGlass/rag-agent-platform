# ---- LLM ----
LLM_PROVIDER=openai          # openai | anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=3

# ---- Vector store ----
VECTOR_BACKEND=chroma        # chroma | qdrant
CHROMA_PATH=./data/chroma
QDRANT_URL=http://localhost:6333

# ---- Storage ----
STORAGE_BACKEND=filesystem   # filesystem | s3
DATA_DIR=./data
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
LOG_JSON=true

# ---- Eval ----
RAGAS_DATASET=evals/data/demo.jsonl
